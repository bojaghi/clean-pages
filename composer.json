{
  "name": "bojaghi/clean-pages",
  "description": "워드프레스 플러그인에서 테마와 완전히 무관한 빈 페이지를 운영하게 도와줌니다.",
  "homepage": "https://github.com/bojaghi/clean-pages",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "changwoo",
      "email": "ep6tri@hotmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "bojaghi/contract": "^2",
    "bojaghi/helper": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "yoast/phpunit-polyfills": "^4.0",
    "bojaghi/dictionary": "^1.0",
    "wp-coding-standards/wpcs": "^3.0",
    "alleyinteractive/composer-wordpress-autoloader": "^1.3"
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf"
  },
  "version": "2.0.0",
  "config": {
    "allow-plugins": {
      "alleyinteractive/composer-wordpress-autoloader": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "wordpress-autoloader": {
      "autoload": {
        "Bojaghi\\CleanPages\\": "inc/"
      },
      "autoload-dev": {
        "Bojaghi\\CleanPages\\Tests\\": "tests/"
      },
      "inject": true
    }
  }
}
